<Page x:Class="Unlose.UI.Views.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,40" AutomationProperties.AutomationId="AboutTitle">
            <TextBlock x:Name="LblAboutTitle" Text="ℹ️  关于" Foreground="#0369A1"
                       FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Semibold, Microsoft YaHei UI"
                       Margin="0,0,0,24"/>

            <!-- App info -->
            <Border Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="LblAppName" Text="unlose 文件安全防护" Foreground="#0369A1"
                               FontSize="17" FontWeight="SemiBold" FontFamily="Segoe UI Semibold, Microsoft YaHei UI"
                               Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="LblVersionTitle" Text="版本" Foreground="#4A7A9B" FontSize="13" Margin="0,0,0,12"/>
                        <TextBlock x:Name="TxtVersion" Grid.Column="1" Foreground="#0C4A6E" FontSize="13" Margin="0,0,0,12"/>

                        <TextBlock x:Name="LblUpdateTitle" Grid.Row="1" Text="更新" Foreground="#4A7A9B" FontSize="13" Margin="0,0,0,12"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="BtnCheckUpdate" Content="检查更新" Click="BtnCheckUpdate_Click"
                                    Padding="12,4" FontSize="12" Cursor="Hand"/>
                            <TextBlock x:Name="TxtUpdateResult" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="#0C4A6E" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock x:Name="LblStatusTitle" Grid.Row="2" Text="服务状态" Foreground="#4A7A9B" FontSize="13" Margin="0,0,0,12"/>
                        <TextBlock x:Name="TxtStatus" Grid.Row="2" Grid.Column="1" Foreground="#0C4A6E" FontSize="13" Margin="0,0,0,12"/>

                        <TextBlock x:Name="LblDataTitle" Grid.Row="3" Text="数据目录" Foreground="#4A7A9B" FontSize="13" Margin="0,0,0,12"/>
                        <TextBlock x:Name="TxtDataDir" Grid.Row="3" Grid.Column="1" Foreground="#0C4A6E" FontSize="13" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <TextBlock x:Name="LblCopyrightTitle" Grid.Row="4" Text="版权" Foreground="#4A7A9B" FontSize="13"/>
                        <TextBlock x:Name="TxtCopyright" Grid.Row="4" Grid.Column="1" Foreground="#0C4A6E" FontSize="13" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Introduction -->
            <Border Style="{StaticResource GlassCard}" Padding="24">
                <TextBlock x:Name="LblAboutBody" Foreground="#0C4A6E" FontSize="13" TextWrapping="Wrap" LineHeight="22"
                           Text="unlose 提供文件系统级卷影保护快照，在 AI 智能体会话开始、执行破坏性操作前自动创建保护，支持按会话定位并恢复误删误改的文件。"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
