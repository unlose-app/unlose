<Window x:Class="Unlose.UI.Views.PathListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="unlose" Height="360" Width="500"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Border Background="White" CornerRadius="12" BorderBrush="#D1D5DB" BorderThickness="1"
            MouseDown="Window_MouseDown">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.15"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="LblTitle" Text="变更监控目录" FontSize="18" FontWeight="SemiBold"
                       Foreground="#0369A1" Margin="0,0,0,8" FontFamily="Segoe UI Semibold, Microsoft YaHei UI"/>

            <TextBlock x:Name="LblPrompt" Grid.Row="1" Text="请添加或删除监控路径（每行一个）："
                       Foreground="#4A7A9B" FontSize="12" Margin="0,0,0,10"/>

            <!-- Path list + action buttons -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="PathListBox" Grid.Column="0"
                         Background="#F8FAFC" Foreground="#0C4A6E"
                         BorderBrush="#D1D5DB" BorderThickness="1"
                         FontSize="13" FontFamily="Consolas"
                         HorizontalContentAlignment="Stretch"/>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Button x:Name="BtnAdd" Content="＋ 添加" Click="AddPath_Click"
                            Background="#EFF6FF" Foreground="#0369A1"
                            BorderBrush="#BFDBFE" BorderThickness="1"
                            Padding="12,8" Margin="0,0,0,8" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bdr" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bdr" Property="Background" Value="#DBEAFE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="BtnDelete" Content="✕ 删除" Click="DeletePath_Click"
                            Background="#FFF7ED" Foreground="#C2410C"
                            BorderBrush="#FDBA74" BorderThickness="1"
                            Padding="12,8" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bdr" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bdr" Property="Background" Value="#FED7AA"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="BtnCancel" Content="取消" Click="Cancel_Click"
                        Background="White" Foreground="#4A7A9B" BorderBrush="#D1D5DB"
                        BorderThickness="1" Padding="20,8" Margin="0,0,12,0" Cursor="Hand"/>
                <Button x:Name="BtnSave" Content="保存" Click="Save_Click"
                        Background="#0369A1" Foreground="White" BorderThickness="0"
                        Padding="20,8" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
