<Page x:Class="Unlose.UI.Views.Pages.RestoreWizard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:Unlose.UI.Converters"
      Background="Transparent">
    <Page.Resources>
        <!-- Localized trigger chip / description for snapshot list items (same converters as the snapshot library page) -->
        <conv:TriggerTypeChipConverter x:Key="TriggerTypeChipConverter"/>
        <conv:SnapshotDescriptionConverter x:Key="SnapshotDescriptionConverter"/>
    </Page.Resources>
    <Grid Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Width="600">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Intro and progress indicator -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,0">
            <TextBlock x:Name="LblTitle" Text="⟲ 回滚向导" Foreground="#0369A1" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" FontFamily="Segoe UI Semibold, Microsoft YaHei UI"/>
            <TextBlock x:Name="StepSubtitleText" Text="第一步：选择时间范围" Foreground="#0EA5E9" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,24"/>
        </StackPanel>

        <!-- Two-step progress bar: circle + connector row and label row, all with fixed column widths for alignment -->
        <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>

            <!-- Connector 1-2 -->
            <Border x:Name="Connector1" Grid.Column="1" Height="3" CornerRadius="1"
                    VerticalAlignment="Center" Background="#E2E8F0"/>

            <!-- Step 1 circle -->
            <Border x:Name="Step1Indicator" Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                    Background="#0369A1" HorizontalAlignment="Center" VerticalAlignment="Top">
                <TextBlock Text="1" Foreground="White" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Step 2 circle -->
            <Border x:Name="Step2Indicator" Grid.Column="2" Width="30" Height="30" CornerRadius="15"
                    Background="#E2E8F0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <TextBlock Text="2" Foreground="#4A7A9B" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Step label row -->
            <TextBlock x:Name="LblStep1Label" Grid.Row="1" Grid.Column="0"
                       Text="时间范围" Foreground="#0369A1" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"/>
            <TextBlock x:Name="LblStep2Label" Grid.Row="1" Grid.Column="2"
                       Text="选择还原点" Foreground="#4A7A9B" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"/>
        </Grid>

        <!-- Step content area -->
        <Grid Grid.Row="2">
            <!-- Step 1: select time range -->
            <StackPanel x:Name="Step2Content" Visibility="Visible">
                <TextBlock x:Name="LblStep2Prompt" Text="大概是什么时候丢失/被改动的？" Foreground="#0C4A6E" FontSize="16" Margin="0,0,0,16"/>

                <RadioButton x:Name="TimeToday" GroupName="TimeAnchor" IsChecked="True" Margin="0,0,0,12" Background="Transparent" Foreground="#0C4A6E" FontSize="14">
                    <RadioButton.Content>
                        <StackPanel>
                            <TextBlock x:Name="LblTodayTitle" Text="📅 今天" FontWeight="SemiBold" Foreground="#0C4A6E"/>
                            <TextBlock x:Name="LblTodayDesc" Text="展示今天（自然日）以来的快照。" Foreground="#4A7A9B" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </RadioButton.Content>
                </RadioButton>

                <RadioButton x:Name="Time7d" GroupName="TimeAnchor" Margin="0,0,0,12" Background="Transparent" Foreground="#0C4A6E" FontSize="14">
                    <RadioButton.Content>
                        <StackPanel>
                            <TextBlock x:Name="Lbl7dTitle" Text="🗓 近 7 天" FontWeight="SemiBold" Foreground="#0C4A6E"/>
                            <TextBlock x:Name="Lbl7dDesc" Text="展示最近 7 天以来的快照。" Foreground="#4A7A9B" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </RadioButton.Content>
                </RadioButton>

                <RadioButton x:Name="Time30d" GroupName="TimeAnchor" Margin="0,0,0,12" Background="Transparent" Foreground="#0C4A6E" FontSize="14">
                    <RadioButton.Content>
                        <StackPanel>
                            <TextBlock x:Name="Lbl30dTitle" Text="🗓 近 30 天" FontWeight="SemiBold" Foreground="#0C4A6E"/>
                            <TextBlock x:Name="Lbl30dDesc" Text="展示最近 30 天以来的快照。" Foreground="#4A7A9B" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </RadioButton.Content>
                </RadioButton>

                <RadioButton x:Name="TimeCustom" GroupName="TimeAnchor" Margin="0,0,0,16" Background="Transparent" Foreground="#0C4A6E" FontSize="14">
                    <RadioButton.Content>
                        <StackPanel>
                            <TextBlock x:Name="LblCustomTitle" Text="🗓 指定日期范围…" FontWeight="SemiBold" Foreground="#0C4A6E"/>
                            <TextBlock x:Name="LblCustomDesc" Text="选择自定义日期范围进行筛选。" Foreground="#4A7A9B" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </RadioButton.Content>
                </RadioButton>

                <!-- Custom date range -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock x:Name="LblStartDate" Text="开始日期：" Foreground="#0C4A6E" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker x:Name="StartDatePicker" FontSize="12" Width="160"/>
                    <TextBlock x:Name="LblEndDate" Text="  结束日期：" Foreground="#0C4A6E" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker x:Name="EndDatePicker" FontSize="12" Width="160"/>
                </StackPanel>
            </StackPanel>

            <!-- Step 2: recommended snapshot list -->
            <Grid x:Name="Step3Content" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="LblStep3Prompt" Grid.Row="0" Text="请选择还原点：" Foreground="#0C4A6E" FontSize="16" Margin="0,0,0,12"/>
                <Border Grid.Row="1" Background="#80FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="8" Padding="0" MaxHeight="260">
                    <ListView x:Name="CandidateSnapshotList" Background="Transparent" BorderThickness="0"
                              Foreground="#0C4A6E" SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="Padding" Value="16,10"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#40FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#330369A1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding CreatedAt, StringFormat=\{0:yyyy-MM-dd HH:mm\}}"
                                               Foreground="#0369A1" FontSize="12" FontFamily="Consolas" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ., Converter={StaticResource TriggerTypeChipConverter}}" Foreground="#0C4A6E" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ., Converter={StaticResource SnapshotDescriptionConverter}}" Foreground="#4A7A9B" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
                <StackPanel x:Name="Step3StatusPanel" Grid.Row="1" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,24">
                    <TextBlock x:Name="Step3StatusText" Text="该时间范围内暂无快照。"
                               Foreground="#4A7A9B" FontSize="13" TextAlignment="Center"
                               TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    <Button x:Name="BtnRetrySnapshots" Content="重试" Click="BtnRetrySnapshots_Click"
                            Style="{StaticResource SecondaryButton}" Background="White"
                            Foreground="#4A7A9B" BorderBrush="#D1D5DB" BorderThickness="1"
                            Padding="14,6" Margin="0,12,0,0" Cursor="Hand"
                            HorizontalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Action area -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="PrevButton" Content="← 上一步" Background="White" Foreground="#4A7A9B"
                    BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,16,0" Cursor="Hand"
                    Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Click="PrevStep_Click"/>
            <Button x:Name="BtnCancel" Content="取消并返回" Background="White" Foreground="#4A7A9B" BorderBrush="#D1D5DB" BorderThickness="1"
                    Margin="0,0,16,0" Cursor="Hand" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
            <Button x:Name="NextButton" Content="下一步 ➡️" Style="{StaticResource ModernButton}"
                    Padding="16,10" Cursor="Hand" Click="NextStep_Click"/>
        </StackPanel>

    </Grid>
</Page>
