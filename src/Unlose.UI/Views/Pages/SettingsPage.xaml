<Page x:Class="Unlose.UI.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="192"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left anchor navigation -->
        <Border Background="#33FFFFFF" BorderThickness="0,0,1,0" BorderBrush="#66FFFFFF" Padding="20">
            <StackPanel x:Name="NavStackPanel">
                <TextBlock x:Name="LblSettingsNavTitle" Text="控制台策略" Foreground="#4A7A9B"
                           FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>
                <TextBlock x:Name="LblNavStorage" Text="储存与保留控制" Foreground="#0369A1"
                           FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" Cursor="Hand"
                           MouseLeftButtonUp="Nav_Click" Tag="SectionStorage"/>
                <TextBlock x:Name="LblNavAgent" Text="Agent 告警与响应" Foreground="#4A7A9B"
                           FontSize="13" Margin="0,0,0,10" Cursor="Hand"
                           MouseLeftButtonUp="Nav_Click" Tag="SectionAgent"/>
                <TextBlock x:Name="LblNavSystem" Text="系统底层与通知" Foreground="#4A7A9B"
                           FontSize="13" Margin="0,0,0,10" Cursor="Hand"
                           MouseLeftButtonUp="Nav_Click" Tag="SectionSystem"/>
                <TextBlock x:Name="LblNavMcp" Text="MCP 集成向导" Foreground="#4A7A9B"
                           FontSize="13" Margin="0,0,0,10" Cursor="Hand"
                           MouseLeftButtonUp="Nav_Click" Tag="SectionMcp"/>
                <TextBlock x:Name="LblNavDiag" Text="诊断与空闲释放" Foreground="#4A7A9B"
                           FontSize="13" Cursor="Hand"
                           MouseLeftButtonUp="Nav_Click" Tag="SectionDiag"/>
            </StackPanel>
        </Border>

        <!-- Right detail sections -->
        <ScrollViewer x:Name="ContentScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,40" AutomationProperties.AutomationId="SettingsTitle">
                <TextBlock x:Name="LblSettingsTitle" Text="⚙️  设置中心" Foreground="#0369A1"
                           FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Semibold, Microsoft YaHei UI"
                           Margin="0,0,0,24"/>

                <!-- Section 1: Storage & Retention -->
                <Border x:Name="SectionStorage" Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock x:Name="LblSectionStorage" Text="💽  储存与保留控制" Foreground="#0369A1"
                                   FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI Semibold, Microsoft YaHei UI"
                                   Margin="0,0,0,16"/>
                        <Border Height="1" Background="#1A0369A1" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="LblWatchPaths" Text="监控保护目标 (盘符与路径)"
                                           Foreground="#0C4A6E" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LblWatchPathsDesc" Text="定义哪些区域的操作会被 VSS 系统打下快照。"
                                           Foreground="#4A7A9B" FontSize="11" Margin="0,4,0,8"/>
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                        CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock x:Name="WatchPathsText" Text="" Foreground="#1D4ED8"
                                               FontSize="12" FontFamily="Consolas"/>
                                </Border>
                            </StackPanel>
                            <Button x:Name="BtnChangePaths" Grid.Column="1" Content="变更保护卷"
                                    Click="ChangePaths_Click"
                                    Background="#EFF6FF" Foreground="#0369A1"
                                    BorderBrush="#BFDBFE" BorderThickness="1"
                                    Padding="14,8" VerticalAlignment="Center" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bdr"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <Border Background="#80FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1"
                                CornerRadius="10" Padding="16,12">
                            <StackPanel>
                                <!-- Scheduled snapshots: fixed times (default, config.Snapshot.ScheduleTimes) or interval-based (legacy rule, IntervalHours) -->
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,185,0">
                                        <TextBlock x:Name="LblSnapshotInterval" Text="定时快照"
                                                   Foreground="#0C4A6E" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="LblSnapshotIntervalDesc" Text="每天在定点时刻自动创建快照（默认）；也可切换为按间隔周期。"
                                                   Foreground="#4A7A9B" FontSize="11" TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="ScheduleModeCombo" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" Width="170" FontSize="12"
                                              Background="White" BorderBrush="#D1D5DB"
                                              SelectionChanged="ScheduleMode_Changed" SelectedIndex="0">
                                        <ComboBoxItem x:Name="CbiModeFixed" Content="定点时刻 (默认)"/>
                                        <ComboBoxItem x:Name="CbiModeInterval" Content="按间隔周期"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Fixed-times editor: chips list + time picker to add (1-N entries) -->
                                <StackPanel x:Name="FixedTimesPanel" Margin="0,0,0,14">
                                    <WrapPanel x:Name="TimesChipPanel"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <ComboBox x:Name="HourCombo" Width="58" FontSize="12"
                                                  FontFamily="Consolas" Background="White"
                                                  BorderBrush="#D1D5DB"/>
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="3,0"
                                                   Foreground="#4A7A9B" FontSize="12"/>
                                        <ComboBox x:Name="MinuteCombo" Width="58" FontSize="12"
                                                  FontFamily="Consolas" Background="White"
                                                  BorderBrush="#D1D5DB"/>
                                        <Border x:Name="BtnAddTime" Margin="10,0,0,0" Padding="10,3"
                                                Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                                CornerRadius="6" Cursor="Hand"
                                                MouseLeftButtonUp="AddTime_Click">
                                            <TextBlock x:Name="LblAddTime" Text="+ 添加时间点"
                                                       Foreground="#0369A1" FontSize="12"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Interval-based mode (legacy rule, kept) -->
                                <Grid x:Name="IntervalPanel" Margin="0,0,0,14" Visibility="Collapsed">
                                    <StackPanel Margin="0,0,185,0">
                                        <TextBlock x:Name="LblIntervalDesc" Text="服务按此周期自动为保护卷打快照。"
                                                   Foreground="#4A7A9B" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox x:Name="RetentionPolicyCombo" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" Width="170" FontSize="12"
                                              Background="White" BorderBrush="#D1D5DB" SelectedIndex="2">
                                        <ComboBoxItem x:Name="CbiInterval6" Content="每 6 小时"/>
                                        <ComboBoxItem x:Name="CbiInterval12" Content="每 12 小时"/>
                                        <ComboBoxItem x:Name="CbiInterval24" Content="每 24 小时 (默认)"/>
                                        <ComboBoxItem x:Name="CbiInterval48" Content="每 48 小时"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Low-space suspend threshold (maps to config.Snapshot.StorageThresholdGb) -->
                                <Grid Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock x:Name="LblStorageThreshold" Text="低空间挂起阈值"
                                                   Foreground="#0C4A6E" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="LblStorageThresholdDesc" Text="磁盘可用空间低于该阈值时，自动暂停快照保护。"
                                                   Foreground="#4A7A9B" FontSize="11" TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="StorageThresholdCombo" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" Width="160" FontSize="12"
                                              Background="White" BorderBrush="#D1D5DB" SelectedIndex="1">
                                        <ComboBoxItem x:Name="CbiThreshold1" Content="1 GB"/>
                                        <ComboBoxItem x:Name="CbiThreshold2" Content="2 GB (默认)"/>
                                        <ComboBoxItem x:Name="CbiThreshold5" Content="5 GB"/>
                                        <ComboBoxItem x:Name="CbiThreshold10" Content="10 GB"/>
                                    </ComboBox>
                                </Grid>

                                <!-- 24h snapshot retention count (maps to config.Snapshot.Retention24hCount) -->
                                <Grid Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock x:Name="LblRetention24h" Text="24 小时快照保留数"
                                                   Foreground="#0C4A6E" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="LblRetention24hDesc" Text="最近 24 小时内最多保留的非固定快照数。Agent 高频会话场景建议 ≥30；其余时段每天/每周仍自动各保留 1 个。"
                                                   Foreground="#4A7A9B" FontSize="11" TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="Retention24hCombo" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" Width="170" FontSize="12"
                                              Background="White" BorderBrush="#D1D5DB" SelectedIndex="2">
                                        <ComboBoxItem x:Name="CbiRetention10" Content="10 个"/>
                                        <ComboBoxItem x:Name="CbiRetention20" Content="20 个"/>
                                        <ComboBoxItem x:Name="CbiRetention30" Content="30 个 (默认)"/>
                                        <ComboBoxItem x:Name="CbiRetention50" Content="50 个"/>
                                        <ComboBoxItem x:Name="CbiRetention100" Content="100 个"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Master switch for full-volume in-place restore (maps to config.Snapshot.EnableInPlaceVolumeRestore, default off) -->
                                <Grid Margin="0,0,0,14">
                                    <StackPanel Margin="0,0,185,0">
                                        <TextBlock x:Name="LblInPlaceRestore" Text="整卷原位还原（高风险）"
                                                   Foreground="#B91C1C" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="LblInPlaceRestoreDesc" Text="开启后显示「整卷原位还原」入口：把快照整卷覆盖回原位置，卷上现有文件将被替换、快照之后新建的文件将被删除。仅限非系统盘；系统盘请使用 Windows 系统还原。"
                                                   Foreground="#4A7A9B" FontSize="11" TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkInPlaceRestore" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" FontSize="12"
                                              Foreground="#B91C1C" IsChecked="False">
                                        <TextBlock x:Name="LblInPlaceRestoreSwitch" Text="启用（仅限非系统盘）"/>
                                    </CheckBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Section 2: Agent Alert & Response -->
                <Border x:Name="SectionAgent" Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,20"
                        BorderBrush="#FDBA74">
                    <StackPanel>
                        <TextBlock x:Name="LblSectionAgent" Text="🤖  Agent 进程监控" Foreground="#D97706"
                                   FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI Semibold, Microsoft YaHei UI"
                                   Margin="0,0,0,16"/>
                        <Border Height="1" Background="#1AD97706" Margin="0,0,0,16"/>

                        <TextBlock x:Name="LblAgentMonitor" Text="附加监控进程清单"
                                   Foreground="#0C4A6E" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LblAgentMonitorDesc" Text="除内置清单外额外监控的进程。检测到这些进程启动时会自动创建保护快照；如需修改请编辑 config.json 的 Agent.MonitoredProcesses。"
                                   Foreground="#4A7A9B" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                    CornerRadius="4" Padding="10,4">
                                <!-- Populated at runtime by LoadCurrentSettingsAsync from config.Agent.MonitoredProcesses -->
                                <TextBlock x:Name="AgentProcessesText" Text="" FontFamily="Consolas"
                                           FontSize="12" Foreground="#0C4A6E" TextWrapping="Wrap"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock x:Name="LblAgentBuiltinNote" Text="另内置 25+ 款主流 AI Agent 进程监控。"
                                   Foreground="#4A7A9B" FontSize="11" Margin="0,0,0,16"/>
                    </StackPanel>
                </Border>

                <!-- Section 4: System & Notifications -->
                <Border x:Name="SectionSystem" Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock x:Name="LblSectionSystem" Text="🪟  系统底层与通知" Foreground="#0369A1"
                                   FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI Semibold, Microsoft YaHei UI"
                                   Margin="0,0,0,16"/>
                        <Border Height="1" Background="#1A0369A1" Margin="0,0,0,16"/>

                        <StackPanel>
                                <TextBlock x:Name="LblGeneral" Text="常规配置" Foreground="#0C4A6E"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock x:Name="LblAutoStart" Text="unlose 服务已注册为开机自启（安装时设定）。"
                                           Foreground="#0C4A6E" FontSize="12" TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="LblUiLang" Text="界面语言：" Foreground="#0C4A6E" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="UiLangComboBox" Width="120" FontSize="12" SelectedIndex="0"
                                              IsEnabled="False"
                                              Background="White" BorderBrush="#D1D5DB">
                                        <ComboBoxItem x:Name="CbiLangZh" Content="简体中文"/>
                                        <ComboBoxItem x:Name="CbiLangEn" Content="English"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock x:Name="LblUiLangNa" Text="请使用标题栏语言切换"
                                           Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0"/>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock x:Name="LblNotifyLevel" Text="快照通知：" Foreground="#0C4A6E" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="NotifyLevelComboBox" Width="150" FontSize="12" SelectedIndex="0"
                                              Background="White" BorderBrush="#D1D5DB">
                                        <ComboBoxItem x:Name="CbiNotifyAll" Content="全部提示 (默认)"/>
                                        <ComboBoxItem x:Name="CbiNotifyFailures" Content="仅失败时提示"/>
                                        <ComboBoxItem x:Name="CbiNotifySilent" Content="完全静默"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock x:Name="LblNotifyLevelDesc" Text="托盘气泡通知的显示档位；快照列表的实时刷新不受影响。"
                                           Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Section 5: MCP Integration -->
                <Border x:Name="SectionMcp" Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock x:Name="LblSectionMcp" Text="🔌  MCP 集成向导" Foreground="#0369A1"
                                   FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI Semibold, Microsoft YaHei UI"
                                   Margin="0,0,0,16"/>
                        <Border Height="1" Background="#1A0369A1" Margin="0,0,0,16"/>
                        <TextBlock x:Name="LblMcpDesc" TextWrapping="Wrap"
                                   Text="通过 MCP 协议向 AI 工具（如 Claude、Cursor）开放 unlose 的快照管理能力。配置完成后，AI 可自主触发快照、查询状态，实现零感知保护。"
                                   Foreground="#4A7A9B" FontSize="12" Margin="0,0,0,14"/>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                CornerRadius="8" Padding="16,12">
                            <StackPanel>
                                <TextBlock x:Name="LblMcpAddress" Text="MCP 服务程序（stdio 模式）" Foreground="#0C4A6E" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtMcpExePath" Text="unlose.McpServer.exe（位于安装目录的 mcpserver 子目录）" FontFamily="Consolas" FontSize="12" Foreground="#1D4ED8" TextWrapping="Wrap"/>
                                <TextBlock x:Name="LblMcpConfigTitle" Text="配置示例（填入 AI 工具的 MCP 配置文件）：" Foreground="#0C4A6E" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,6"/>
                                <Border Background="White" BorderBrush="#BFDBFE" BorderThickness="1"
                                        CornerRadius="4" Padding="10,8">
                                    <!-- Example JSON filled in by ApplyLanguage (identical in both languages) -->
                                    <TextBlock x:Name="TxtMcpConfigExample" Text="" FontFamily="Consolas"
                                               FontSize="11" Foreground="#0C4A6E" TextWrapping="Wrap"/>
                                </Border>
                                <TextBlock x:Name="LblMcpHint" Text="command 路径请按实际安装目录调整；服务提供 7 个快照管理工具。" Foreground="#4A7A9B" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Section 6: Diagnostics & Idle Release -->
                <Border x:Name="SectionDiag" Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock x:Name="LblSectionDiag" Text="🔬  诊断与空闲释放" Foreground="#0369A1"
                                   FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI Semibold, Microsoft YaHei UI"
                                   Margin="0,0,0,16"/>
                        <Border Height="1" Background="#1A0369A1" Margin="0,0,0,16"/>
                        <TextBlock x:Name="LblDiagDesc" Text="查看服务运行诊断信息，清理过期临时数据，释放磁盘空间。"
                                   Foreground="#4A7A9B" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnOpenLogFolder" Content="📂  打开日志目录"
                                    Click="OpenLogFolder_Click"
                                    Background="#EFF6FF" Foreground="#0369A1"
                                    BorderBrush="#BFDBFE" BorderThickness="1"
                                    Padding="14,8" Margin="0,0,12,0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bdr" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="BtnClearTempData" Content="🧹  清理过期日志 (30 天前)"
                                    Click="ClearTempData_Click"
                                    Background="#FFF7ED" Foreground="#C2410C"
                                    BorderBrush="#FDBA74" BorderThickness="1"
                                    Padding="14,8" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bdr" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Save button -->
                <StackPanel HorizontalAlignment="Right">
                    <TextBlock x:Name="LblSaveNote" Text="快照间隔、低空间阈值与保护卷将保存到服务配置"
                               Foreground="#94A3B8" FontSize="11"
                               HorizontalAlignment="Right" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnResetConfig" Content="重置配置文件 (需重启服务)" Background="Transparent"
                                Click="ResetConfig_Click"
                                Foreground="#4A7A9B" BorderThickness="0"
                                Margin="0,0,16,0" Cursor="Hand" Padding="12,8" FontSize="13"/>
                        <Button x:Name="BtnSaveConfig" Content="💾  保存配置"
                                Style="{StaticResource ModernButton}"
                                Padding="24,10" FontSize="13" Click="Save_Click"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
