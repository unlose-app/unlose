<Window x:Class="Unlose.UI.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="unlose" Height="200" Width="460"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Border Background="White" CornerRadius="12" BorderBrush="#D1D5DB" BorderThickness="1"
            MouseDown="Window_MouseDown">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.15"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="LblTitle" Text="" FontSize="18" FontWeight="SemiBold"
                       Foreground="#0369A1" Margin="0,0,0,12" FontFamily="Segoe UI Semibold, Microsoft YaHei UI"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="LblMessage" Grid.Row="1" Text=""
                       Foreground="#4A7A9B" FontSize="13" TextWrapping="Wrap"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="BtnCancel" Content="取消" Click="Cancel_Click"
                        Background="White" Foreground="#4A7A9B" BorderBrush="#D1D5DB"
                        BorderThickness="1" Padding="20,8" Margin="0,0,12,0" Cursor="Hand"/>
                <Button x:Name="BtnConfirm" Content="确认" Click="Confirm_Click"
                        Background="#DC2626" Foreground="White" BorderThickness="0"
                        Padding="20,8" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
