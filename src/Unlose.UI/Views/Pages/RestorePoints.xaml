<Page x:Class="Unlose.UI.Views.Pages.RestorePoints"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Restore Points"
      Background="Transparent">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header action bar -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="LblPageTitle" Text="🛡️  系统还原点" Foreground="#0369A1"
                       FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Semibold, Microsoft YaHei UI"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnRefreshList" Content="↻  刷新列表" Background="White"
                        Foreground="#0369A1" BorderBrush="#D1D5DB" BorderThickness="1"
                        Padding="14,8" Margin="0,0,10,0" Cursor="Hand" Click="Refresh_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bdr" Background="White"
                                                BorderBrush="#D1D5DB" BorderThickness="1"
                                                CornerRadius="8" Padding="14,8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bdr" Property="Background" Value="#F0F9FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="BtnCreateRestorePoint" Content="＋  立即创建还原点"
                        Style="{StaticResource ModernButton}"
                        Padding="16,8" Cursor="Hand" Click="CreateRestorePoint_Click"/>
            </StackPanel>
        </Grid>

        <!-- Description text -->
        <TextBlock Grid.Row="1" Margin="0,0,0,20" TextWrapping="Wrap" MaxWidth="600"
                   HorizontalAlignment="Left">
            <Run x:Name="RunDescPrefix" Text="用于修复系统崩溃、蓝屏、驱动问题。（恢复丢失的文件请使用 "
                 Foreground="#4A7A9B" FontSize="12"/>
            <Run x:Name="RunDescLink" Text="📂 快照管理 →" Foreground="#0369A1" FontSize="12" FontWeight="SemiBold"
                 Cursor="Hand" MouseLeftButtonUp="RunDescLink_MouseLeftButtonUp"/>
            <Run x:Name="RunDescSuffix" Text="）" Foreground="#4A7A9B" FontSize="12"/>
        </TextBlock>

        <!-- Restore point list (Glass Card) -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table header -->
                <Border Grid.Row="0" Background="#80FFFFFF" BorderThickness="0,0,0,1"
                        BorderBrush="#E2E8F0" Padding="24,12" CornerRadius="12,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ColDateTime" Text="日期与时间" Foreground="#4A7A9B"
                                   FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="ColDesc" Grid.Column="1" Text="描述" Foreground="#4A7A9B"
                                   FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="ColSource" Grid.Column="2" Text="来源" Foreground="#4A7A9B"
                                   FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="ColAction" Grid.Column="3" Text="操作" Foreground="#4A7A9B"
                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Restore point list -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- Empty state hint -->
                        <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="0,40,0,40">
                            <TextBlock Text="🛡️" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock x:Name="EmptyStateTitle" Text="暂无系统还原点"
                                       Foreground="#0C4A6E" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock x:Name="EmptyStateDesc"
                                       Text="未检测到 Windows 系统还原点。点击上方「立即创建还原点」可立即生成一个。"
                                       Foreground="#4A7A9B" FontSize="12" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="320" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl x:Name="RestorePointsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="#F3F4F6"
                                        Padding="24,16" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#80FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}"
                                                   Foreground="#0C4A6E" FontSize="13"
                                                   FontFamily="Consolas" FontWeight="Medium"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Description}"
                                                   Foreground="#0C4A6E" FontSize="13"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Background="#DBEAFE"
                                                BorderBrush="#BFDBFE" BorderThickness="1"
                                                CornerRadius="4" Padding="8,3"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SourceLabel}" Foreground="#1D4ED8" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <Button x:Name="BtnRestoreToPoint" Grid.Column="3" Content="还原到此点"
                                                Tag="{Binding SequenceNumber}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Padding="12,6" Cursor="Hand" FontSize="12"
                                                Loaded="BtnRestoreToPoint_Loaded"
                                                Click="RestorePoint_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bdr" Background="White"
                                                                        BorderBrush="#D1D5DB" BorderThickness="1"
                                                                        CornerRadius="6" Padding="12,6">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bdr" Property="Background" Value="#F0F9FF"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
