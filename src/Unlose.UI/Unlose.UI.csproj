<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\unlose.ico</ApplicationIcon>
    <AssemblyName>unlose.UI</AssemblyName>
    <StartupObject>Unlose.UI.App</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Unlose.Core\Unlose.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Resources\unlose.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Title bar logo as PNG (referenced by the Image control via pack URI) -->
    <Resource Include="Resources\app-icon.png" />
  </ItemGroup>
</Project>
