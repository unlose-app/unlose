<Page x:Class="Unlose.UI.Views.Pages.SnapshotLibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:Unlose.UI.Converters"
      Background="Transparent">
    <Page.Resources>
        <conv:TriggerTypeChipConverter x:Key="TriggerTypeChipConverter"/>
        <conv:SnapshotDescriptionConverter x:Key="SnapshotDescriptionConverter"/>
        <conv:PinnedTextConverter x:Key="PinnedTextConverter"/>
        <conv:UtcToLocalTimeConverter x:Key="UtcToLocalTimeConverter"/>
    </Page.Resources>
    <Grid>
        <!-- Two-column layout: list on the left, detail drawer on the right -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Left main area -->
        <Grid Grid.Column="0" Margin="24,20,12,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Page title -->
            <DockPanel LastChildFill="True" Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnBatchDelete" Content="批量删除" Visibility="Collapsed"
                            Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECACA"
                            BorderThickness="1" Padding="14,7" Margin="0,0,8,0"
                            Cursor="Hand" Click="BatchDelete_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bdr" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bdr" Property="Background" Value="#FCA5A5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button DockPanel.Dock="Right" Content="刷新" x:Name="RefreshSnapshotBtn"
                            Click="Refresh_Click"
                            Style="{StaticResource ModernButton}" VerticalAlignment="Center"
                            Padding="14,7"/>
                </StackPanel>
                <TextBlock x:Name="PageTitle" Text="快照列表" Foreground="#0369A1"
                           FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Semibold, Microsoft YaHei UI"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Retention policy note (clears up the "why did my snapshots disappear" confusion) -->
            <TextBlock x:Name="LblRetentionNote" Grid.Row="1" Margin="2,0,0,12" FontSize="11" Foreground="#94A3B8"
                       TextWrapping="Wrap"
                       Text="保留策略：最近 24 小时完整保留（默认最多 30 个）；更早的每天保留最早和最新 2 个，7~30 天每周保留 1 个，超过 30 天自动清理；锁定 🔒 的快照永不清理。"/>

            <!-- Date filter bar (Glass Card) -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="16,12" Margin="0,0,0,14">
                <DockPanel>
                    <ComboBox x:Name="TriggerTypeFilterCombo" DockPanel.Dock="Right" Width="200" FontSize="12"
                              Background="White" BorderBrush="#E2E8F0"
                              SelectionChanged="TriggerTypeFilter_SelectionChanged">
                        <ComboBoxItem x:Name="CbiTriggerAll" Content="全部触发类型" IsSelected="True" Tag=""/>
                        <ComboBoxItem x:Name="CbiTriggerScheduled" Content="定时快照" Tag="Scheduled"/>
                        <ComboBoxItem x:Name="CbiTriggerAgentPre" Content="Agent 启动前" Tag="AgentPreSession"/>
                        <ComboBoxItem x:Name="CbiTriggerAgentInit" Content="Agent 主动快照" Tag="AgentInitiated"/>
                        <ComboBoxItem x:Name="CbiTriggerManual" Content="手动" Tag="Manual"/>
                        <ComboBoxItem x:Name="CbiTriggerPreRestore" Content="还原前备份" Tag="PreRestore"/>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="Filter24h" Content="近24小时" Foreground="#0C4A6E" Margin="0,0,16,0" IsChecked="True" FontSize="12"
                                     Checked="TimeFilter_Checked"/>
                        <RadioButton x:Name="Filter7d" Content="近7天" Foreground="#0C4A6E" Margin="0,0,16,0" FontSize="12"
                                     Checked="TimeFilter_Checked"/>
                        <RadioButton x:Name="FilterAll" Content="全部历史" Foreground="#0C4A6E" FontSize="12"
                                     Checked="TimeFilter_Checked"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Snapshot list (Glass Card container) -->
            <Border Grid.Row="3" Style="{StaticResource GlassCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header row -->
                    <Border Grid.Row="0" Background="#80FFFFFF" BorderThickness="0,0,0,1"
                            BorderBrush="#66FFFFFF" Padding="16,10" CornerRadius="12,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="SelectAllCheckBox" Grid.Column="0" Margin="8,0,0,0"
                                      Checked="SelectAll_Changed" Unchecked="SelectAll_Changed"/>
                            <TextBlock x:Name="ColTime" Grid.Column="1" Text="创建时间" Foreground="#4A7A9B"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="ColTrigger" Grid.Column="2" Text="触发类型" Foreground="#4A7A9B" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="ColDesc" Grid.Column="3" Text="描述" Foreground="#4A7A9B" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="ColStatus" Grid.Column="4" Text="状态" Foreground="#4A7A9B"
                                       FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Scrollable snapshot list (with an overlaid empty-state panel) -->
                    <Grid Grid.Row="1">
                    <ListView Name="SnapshotList" Background="Transparent"
                              BorderThickness="0" Foreground="#0C4A6E"
                              SelectionMode="Extended"
                              SelectionChanged="SnapshotList_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#40FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#330369A1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>
                                <GridViewColumn Width="36">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox x:Name="RowSelectCheckBox" Margin="8,0,0,0"
                                                      Checked="BatchCheckBox_Changed" Unchecked="BatchCheckBox_Changed"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CreatedAt, Converter={StaticResource UtcToLocalTimeConverter}, StringFormat=MM-dd HH:mm:ss}"
                                                       Foreground="#0369A1" FontSize="12"
                                                       FontFamily="Consolas" FontWeight="Bold"
                                                       Margin="4,12,0,12"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="8,2" Margin="0,10,0,10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F3F4F6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TriggerType}" Value="Scheduled">
                                                                <Setter Property="Background" Value="#EFF6FF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TriggerType}" Value="AgentPreSession">
                                                                <Setter Property="Background" Value="#F0FDF4"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TriggerType}" Value="AgentInitiated">
                                                                <Setter Property="Background" Value="#F0FDF4"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TriggerType}" Value="Manual">
                                                                <Setter Property="Background" Value="#FFFBEB"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TriggerType}" Value="PreRestore">
                                                                <Setter Property="Background" Value="#F5F3FF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="Bold"
                                                           Text="{Binding ., Converter={StaticResource TriggerTypeChipConverter}}"
                                                           ToolTip="{Binding ., Converter={StaticResource TriggerTypeChipConverter}}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#4A7A9B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TriggerType}" Value="Scheduled">
                                                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding TriggerType}" Value="AgentPreSession">
                                                                    <Setter Property="Foreground" Value="#059669"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding TriggerType}" Value="AgentInitiated">
                                                                    <Setter Property="Foreground" Value="#059669"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding TriggerType}" Value="Manual">
                                                                    <Setter Property="Foreground" Value="#D97706"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding TriggerType}" Value="PreRestore">
                                                                    <Setter Property="Foreground" Value="#7C3AED"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="280">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ., Converter={StaticResource SnapshotDescriptionConverter}}"
                                                       ToolTip="{Binding ., Converter={StaticResource SnapshotDescriptionConverter}}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="#4A7A9B" FontSize="12"
                                                       FontFamily="Consolas" Margin="0,12"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" HorizontalAlignment="Center" Margin="0,12"
                                                       Text="{Binding IsPinned, Converter={StaticResource PinnedTextConverter}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#9CA3AF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                <Setter Property="Foreground" Value="#D97706"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                        <!-- Empty-state panel: shown when there are no snapshots or no filter matches -->
                        <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#x1F4F7;" FontSize="36" HorizontalAlignment="Center"
                                       Margin="0,0,0,10" Opacity="0.6"/>
                            <TextBlock x:Name="EmptyStateTitle" Text="暂无快照" Foreground="#0C4A6E"
                                       FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyStateHint" Text="可在概览页立即补充一拍"
                                       Foreground="#4A7A9B" FontSize="11"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Pagination controls -->
            <Border Grid.Row="4" Style="{StaticResource GlassCard}" Padding="12,10" Margin="0,12,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="LblPageSize" Text="每页显示" Foreground="#4A7A9B"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="PageSizeComboBox" Width="70" FontSize="11"
                                  Background="White" BorderBrush="#D1D5DB"
                                  SelectedIndex="1" SelectionChanged="PageSize_SelectionChanged">
                            <ComboBoxItem Content="20"/>
                            <ComboBoxItem Content="50"/>
                            <ComboBoxItem Content="100"/>
                            <ComboBoxItem Content="200"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="BtnFirstPage" Content="⏮ 首页" Style="{StaticResource ModernButton}"
                                FontSize="11" Padding="10,5" Margin="0,0,4,0" IsEnabled="False" Click="BtnFirstPage_Click"/>
                        <Button x:Name="BtnPrevPage" Content="◀ 上一页" Style="{StaticResource ModernButton}"
                                FontSize="11" Padding="10,5" Margin="0,0,4,0" IsEnabled="False" Click="BtnPrevPage_Click"/>
                        <TextBlock x:Name="TxtPageInfo" Text="第 1 / 1 页" Foreground="#0C4A6E"
                                   FontSize="12" FontWeight="Medium" VerticalAlignment="Center"
                                   Margin="8,0"/>
                        <Button x:Name="BtnNextPage" Content="下一页 ▶" Style="{StaticResource ModernButton}"
                                FontSize="11" Padding="10,5" Margin="4,0,0,0" IsEnabled="False" Click="BtnNextPage_Click"/>
                        <Button x:Name="BtnLastPage" Content="末页 ⏭" Style="{StaticResource ModernButton}"
                                FontSize="11" Padding="10,5" Margin="4,0,0,0" IsEnabled="False" Click="BtnLastPage_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="LblTotalCount" Text="共 0 条" Foreground="#4A7A9B"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Right drawer panel (Detail Drawer) -->
        <Border Grid.Column="1" Background="#66FFFFFF" BorderThickness="1,0,0,0"
                BorderBrush="#66FFFFFF">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="20,20,20,0">
                    <StackPanel>
                        <!-- Snapshot title -->
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="DrawerTimestamp" Text="—"
                                           Foreground="#0C4A6E" FontSize="20" FontWeight="Bold"
                                           FontFamily="Segoe UI Semibold, Microsoft YaHei UI"/>
                                <TextBlock x:Name="DrawerSnapshotId" Text="Object ID: —"
                                           Foreground="#4A7A9B" FontSize="10"
                                           FontFamily="Consolas" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="#F97316" CornerRadius="4" Padding="8,3">
                                <TextBlock x:Name="DrawerTrigger" Text="—"
                                           Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <!-- Context summary -->
                        <Border Background="#80FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock x:Name="LblContextMeta" Text="触发详情" Foreground="#4A7A9B"
                                           FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="DrawerContextMeta" Text="—"
                                           Foreground="#0C4A6E" FontSize="11"
                                           FontFamily="Consolas" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Snapshot properties -->
                        <StackPanel>
                            <Border BorderThickness="0,0,0,1" BorderBrush="#E2E8F0" Padding="0,6">
                                <Grid>
                                    <TextBlock x:Name="LblVolumes" Text="保护卷"
                                               Foreground="#4A7A9B" FontSize="11" FontFamily="Consolas"/>
                                    <TextBlock x:Name="DrawerVolumes" Text="—"
                                               Foreground="#0C4A6E" FontSize="11"
                                               FontWeight="Bold" FontFamily="Consolas"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <Border BorderThickness="0,0,0,1" BorderBrush="#E2E8F0" Padding="0,6">
                                <Grid>
                                    <TextBlock x:Name="LblSession" Text="会话标识"
                                               Foreground="#4A7A9B" FontSize="11" FontFamily="Consolas"/>
                                    <TextBlock x:Name="DrawerSessionId" Text="—"
                                               Foreground="#0C4A6E" FontSize="11"
                                               FontWeight="Bold" FontFamily="Consolas"
                                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                               MaxWidth="180" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Keep forever -->
                        <Border Margin="0,20,0,0">
                            <StackPanel>
                                <CheckBox x:Name="PinnedCheckBox" FontSize="13"
                                          Foreground="#0C4A6E" FontWeight="Medium"
                                          Checked="PinnedCheckBox_Checked" Unchecked="PinnedCheckBox_Unchecked">
                                    <TextBlock x:Name="LblPinCheck" Text="🔒  置为永久保留快照点" FontSize="13"/>
                                </CheckBox>
                                <TextBlock x:Name="LblPinDesc" Text="打上标记后，系统在磁盘耗尽时也绝不会淘汰清理此节点的数据。"
                                           Foreground="#4A7A9B" FontSize="10"
                                           TextWrapping="Wrap" Margin="20,4,0,0" LineHeight="16"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Action buttons -->
                <Border Grid.Row="1" Background="#80FFFFFF" BorderThickness="0,1,0,0"
                        BorderBrush="#66FFFFFF" Padding="16,14">
                    <StackPanel>
                        <Button x:Name="BtnImmersiveRestore" Content="👁  沉浸式选定文件挑拣恢复"
                                Style="{StaticResource ModernButton}"
                                Padding="12,10" Margin="0,0,0,8"
                                Click="ImmersiveRestore_Click"/>
                        <Button x:Name="BtnFullRestore" Content="📦  整卷原位还原"
                                Background="White" Foreground="#0C4A6E"
                                BorderBrush="#D1D5DB" BorderThickness="1"
                                Padding="12,8" Cursor="Hand" Margin="0,0,0,8"
                                Click="Restore_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bdr" Background="White"
                                                        BorderBrush="#D1D5DB" BorderThickness="1"
                                                        CornerRadius="8" Padding="12,8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bdr" Property="Background" Value="#F0F9FF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="BtnDelete" Content="删除" Foreground="#EF4444" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="Bold"
                                HorizontalAlignment="Center" Margin="0,4,0,0"
                                Click="DeleteSnapshot_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
