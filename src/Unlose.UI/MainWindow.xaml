<Window x:Class="Unlose.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="unlose - 本地文件安全防护" Height="800" Width="1200"
        MinWidth="960" MinHeight="600"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <!-- AllowsTransparency=False + WindowStyle=None + WindowChrome is the standard approach:
         system title-bar dragging, four-edge resizing, double-click maximize, Aero Snap, and
         maximized-without-covering-the-taskbar all work natively.
         (With AllowsTransparency=True a layered window has no non-client area, so all of these
         break; also, an 800px height exceeds the 720p work area and pushes the title bar
         off-screen. The actual window size is clamped to the work area in the constructor.) -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#C7E8F8" Offset="0.0"/>
            <GradientStop Color="#D4F1E4" Offset="0.35"/>
            <GradientStop Color="#C9DFF5" Offset="0.65"/>
            <GradientStop Color="#D5CFF7" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="8" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border BorderThickness="1" BorderBrush="#66FFFFFF">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Custom title bar (h-12 = 48px, bg-white/40, border-b border-white/40) -->
            <Border Grid.Row="0" Background="#66FFFFFF" BorderThickness="0,0,0,1" BorderBrush="#66FFFFFF"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid Background="Transparent" MouseDown="TitleBar_MouseDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                        <Image Source="pack://application:,,,/Resources/app-icon.png" Width="22" Height="22"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="unlose" Foreground="#0369A1"
                                   VerticalAlignment="Center" FontSize="16" FontWeight="Medium"
                                   FontFamily="Segoe UI, Microsoft YaHei UI"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- MCP status indicator (no real data source yet, hidden) -->
                        <Border Background="#80FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1"
                                CornerRadius="12" Padding="12,4" Margin="0,0,12,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="McpStatusText" Text="已接入 1 个环境 (MCP)"
                                       Foreground="#4A7A9B" FontSize="11" FontWeight="Medium"/>
                        </Border>
                        <!-- Language switch -->
                        <Button x:Name="LangSwitchButton" Content="中 / EN" Click="LangSwitchButton_Click"
                                Background="Transparent" Foreground="#4A7A9B"
                                BorderThickness="0" Margin="0,0,8,0" Padding="8,4"
                                WindowChrome.IsHitTestVisibleInChrome="True" FontSize="12"/>
                        <Button x:Name="MinimizeButton" Content="—" Width="40" Background="Transparent" Foreground="#4A7A9B"
                                BorderThickness="0" Click="Minimize_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True" FontSize="14"/>
                        <Button x:Name="MaximizeButton" Content="⬜" Width="40" Background="Transparent" Foreground="#4A7A9B"
                                BorderThickness="0" Click="Maximize_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True" FontSize="12"/>
                        <Button x:Name="CloseButton" Content="✕" Width="40" Background="Transparent"
                                Foreground="{StaticResource DangerBrush}"
                                BorderThickness="0" Click="CloseButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="224"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Side navigation bar (w-56=224px, bg-white/20, border-r border-white/40) -->
                <Border Grid.Column="0" Background="#33FFFFFF" BorderThickness="0,0,1,0" BorderBrush="#66FFFFFF">
                    <StackPanel Margin="16,16,16,16">
                        <!-- Main navigation -->
                        <Button x:Name="NavDashboard" Content="🏠  概览" Tag="Dashboard"
                                Style="{StaticResource NavButtonActive}" Click="NavButton_Click"
                                Margin="0,0,0,4"/>
                        <Button x:Name="NavSnapshots" Content="📂  快照管理" Tag="Snapshots"
                                Style="{StaticResource NavButton}" Click="NavButton_Click"
                                Margin="0,0,0,4"/>
                        <Button x:Name="NavAudit" Content="📋  监控日志" Tag="Audit"
                                Style="{StaticResource NavButton}" Click="NavButton_Click"
                                Margin="0,0,0,4"/>
                        <Button x:Name="NavSettings" Content="⚙️  控制中心" Tag="Settings"
                                Style="{StaticResource NavButton}" Click="NavButton_Click"
                                Margin="0,0,0,4"/>
                        <!-- Separator -->
                        <Border Height="1" Background="#1A0C4A6E" Margin="0,8,0,8"/>
                        <Button x:Name="NavRestorePoints" Content="🛡️  系统还原点" Tag="RestorePoints"
                                Style="{StaticResource NavButton}" Click="NavButton_Click"
                                Margin="0,0,0,4"/>
                        <Button x:Name="NavRestoreWizard" Content="⟲  回滚向导" Tag="RestoreWizard"
                                Style="{StaticResource NavButton}" Click="NavButton_Click"
                                Margin="0,0,0,4"/>
                        <!-- Separator -->
                        <Border Height="1" Background="#1A0C4A6E" Margin="0,8,0,8"/>
                        <Button x:Name="NavAbout" Content="ℹ️  关于" Tag="About"
                                Style="{StaticResource NavButton}" Click="NavButton_Click"
                                Margin="0,0,0,4"/>
                    </StackPanel>
                </Border>
                <!-- Content area -->
                <Frame Grid.Column="1" Name="MainFrame" NavigationUIVisibility="Hidden" Background="Transparent"/>
            </Grid>
        </Grid>
    </Border>
</Window>
