<?xml version="1.0" encoding="utf-8" ?>
<!-- supportedRuntime v4.0 pins CLR 4.x for the net48 assembly; useLegacyV2RuntimeActivationPolicy
     is required for the SfxCA stub (an mscoree v2-era shim) to probe and bind the v4 runtime —
     without it GetRequestedRuntimeInfo fails with 0x80131700 (v1.0.9.3 first-run failure) or the
     stub falls back to CLR v2.0.50727 and the net48 assembly dies with BadImageFormatException. -->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" />
  </startup>
</configuration>
