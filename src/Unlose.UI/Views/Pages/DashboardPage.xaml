<Page x:Class="Unlose.UI.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <!-- The page no longer scrolls as a whole: the banner/hero area size to their content and the card area fills the remaining space;
         only the event list on the right scrolls inside its card (the default window fits everything on one screen) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
            <!-- Service error warning banner (ServiceWarningBanner) -->
            <Border x:Name="ServiceWarningBanner" Grid.Row="0" Padding="12,10" Margin="0,0,0,0" Visibility="Collapsed"
                    Background="#FEF9C3" BorderThickness="0,0,0,1" BorderBrush="#FDE68A">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="WarningBannerText" Text="当前 Agent 会话无保护基线，继续操作可能无法撤销本次 AI 修改。"
                                   Foreground="#92400E" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="CreateSnapshotBtn" Content="立即手动创建快照"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="#0369A1" Foreground="White" BorderThickness="0"
                            Padding="14,6" Cursor="Hand" Click="CreateSnapshot_Click"
                            Style="{StaticResource ModernButton}"/>
                </Grid>
            </Border>

        <!-- Hero section — horizontal layout: logo | status+meta | actions (one screen friendly) -->
        <Border Grid.Row="1" Margin="24,14,24,14" CornerRadius="14" Padding="20,14"
                BorderThickness="1" BorderBrush="#BAE6FD">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#F0F9FF" Offset="0"/>
                    <GradientStop Color="#14FFFFFF" Offset="0.55"/>
                    <GradientStop Color="#F0FDF4" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: brand mark on soft blue disc -->
                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23" VerticalAlignment="Center"
                        Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#0EA5E9" Direction="270" ShadowDepth="0" BlurRadius="10" Opacity="0.18"/>
                    </Border.Effect>
                    <Image Source="/Resources/app-icon.png" Width="26" Height="26"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Middle: status headline + slogan + service meta -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#22C55E"
                                 VerticalAlignment="Center" Margin="0,0,9,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#22C55E" Direction="270" ShadowDepth="0" BlurRadius="8" Opacity="0.45"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="StatusText" Text="保护中"
                                   Foreground="#0C4A6E" FontSize="19" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Semibold, Microsoft YaHei UI"/>
                    </StackPanel>
                    <!-- Brand slogan (official website hero line), follows UI language -->
                    <TextBlock x:Name="SloganText" Text="AI 删掉的东西，用 unlose 找回来"
                               Foreground="#0369A1" FontSize="12.5" FontWeight="Bold" FontStyle="Italic"
                               Margin="18,3,0,0" TextTrimming="CharacterEllipsis"/>
                    <!-- Service meta line -->
                    <TextBlock Margin="18,3,0,0" TextTrimming="CharacterEllipsis">
                        <Run x:Name="RunSubtitlePrefix" Text="保护服务运行正常 • 本地共有 " Foreground="#4A7A9B" FontSize="12.5"/>
                        <Run x:Name="SnapshotCountText" Text="—" Foreground="#0369A1" FontSize="12.5" FontWeight="Bold"/>
                        <Run x:Name="RunSubtitleSuffix" Text=" 个快照可供恢复" Foreground="#4A7A9B" FontSize="12.5"/>
                    </TextBlock>
                </StackPanel>

                <!-- Right: action buttons stacked vertically, right-aligned -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="196">
                    <Button x:Name="BtnRestoreFromHistory" Content="⟲  从历史快照中恢复文件"
                            Style="{StaticResource CtaButton}"
                            HorizontalAlignment="Stretch" Cursor="Hand"
                            Click="RestoreButton_Click"/>
                    <Button x:Name="BtnQuickSnapshot" Content="立即补充一拍"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch" Margin="0,8,0,0"
                            Cursor="Hand" Click="CreateSnapshot_Click"/>
                    <!-- Update entry shown only when a newer version is cached (daily auto-check) -->
                    <Button x:Name="BtnUpdate" Content="⬆  更新"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch" Margin="0,8,0,0"
                            Visibility="Collapsed"
                            Cursor="Hand" Click="BtnUpdate_Click"/>
                </StackPanel>
            </Grid>
        </Border>

            <!-- Main content card area (two columns) -->
            <Grid Grid.Row="2" Margin="24,0,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left column: disk status + Agent status -->
                <StackPanel Grid.Column="0">
                    <!-- Service status and heartbeat card -->
                    <Border Style="{StaticResource GlassCard}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="LblStorageCardTitle" Text="💽  系统级存储保护态势" Foreground="#0369A1"
                                       FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"
                                       FontFamily="Segoe UI Semibold, Microsoft YaHei UI"/>
                            <!-- Storage usage row -->
                            <Border Background="#80FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1"
                                    CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock x:Name="LblStorageUsage" Text="存储用量" Foreground="#0C4A6E" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="StorageUsageText" Text="—"
                                                   Foreground="#4A7A9B" FontSize="12" FontWeight="Medium"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar x:Name="StorageUsageBar" Height="6" Minimum="0" Maximum="100" Value="0"
                                                 Foreground="#0369A1" Background="#1A0369A1" Margin="0,2,0,0">
                                        <ProgressBar.Template>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Border x:Name="PART_Track" CornerRadius="3"
                                                        Background="{TemplateBinding Background}">
                                                    <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                                        <Grid x:Name="Foreground">
                                                            <Border CornerRadius="3" Background="{TemplateBinding Foreground}"/>
                                                        </Grid>
                                                    </Decorator>
                                                </Border>
                                            </ControlTemplate>
                                        </ProgressBar.Template>
                                    </ProgressBar>
                                </StackPanel>
                            </Border>
                            <!-- Auto-snapshot protection status row -->
                            <Border Background="#80FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1"
                                    CornerRadius="10" Padding="12,10">
                                <Grid>
                                    <TextBlock x:Name="LblAutoSnapshot" Text="自动快照" Foreground="#0C4A6E" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="StorageGuardStatusText" Text="正常"
                                               Foreground="#15803D" FontSize="12" FontWeight="Medium"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Agent integration status card -->
                    <Border Style="{StaticResource GlassCard}" Padding="20">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <TextBlock x:Name="LblAgentCardTitle" Text="🤖  Agent 集成状态" Foreground="#0369A1"
                                           FontSize="15" FontWeight="SemiBold"
                                           FontFamily="Segoe UI Semibold, Microsoft YaHei UI"/>
                                <Border x:Name="AgentSessionBadge" HorizontalAlignment="Right" Background="#F3F4F6"
                                        BorderBrush="#E5E7EB" BorderThickness="1"
                                        CornerRadius="10" Padding="8,3">
                                    <TextBlock x:Name="AgentSessionBadgeText" Text="0 活跃"
                                               Foreground="#6B7280" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                            <Border Background="#80FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1"
                                    CornerRadius="10" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6"
                                            Background="#DBEAFE" Margin="0,0,10,0">
                                        <TextBlock Text="AI" Foreground="#1D4ED8" FontSize="12"
                                                   FontWeight="Bold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="AgentStatusText" Text="检查中…"
                                                   Foreground="#0C4A6E" FontSize="13" FontWeight="Medium"/>
                                        <TextBlock x:Name="AgentMetaText" Text="等待活动会话信息…"
                                                   Foreground="#4A7A9B" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right column: recent alerts -->
                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock x:Name="LblAlertsTitle" Text="📋  近期事件 (Top 5)" Foreground="#0369A1"
                                       FontSize="15" FontWeight="SemiBold"
                                       FontFamily="Segoe UI Semibold, Microsoft YaHei UI"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border x:Name="AlertCountBadge" Background="#DCFCE7"
                                        BorderBrush="#BBF7D0" BorderThickness="1"
                                        CornerRadius="10" Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock x:Name="AlertCountText" Text="0 今日"
                                               Foreground="#15803D" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <TextBlock x:Name="AuditLinkText" Text="查看完整审计日志 →" Foreground="#0369A1"
                                           FontSize="12" VerticalAlignment="Center"
                                           Cursor="Hand"
                                           MouseLeftButtonUp="NavigateToAuditLog_MouseLeftButtonUp"/>
                            </StackPanel>
                        </Grid>

                        <!-- Event list: scrolls inside the card (the page itself does not scroll); scrollbar uses the global brand style -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AlertsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" CornerRadius="8" Padding="10,8"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#80FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="#66FFFFFF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                        <Setter Property="Background" Value="#FFF5F5"/>
                                                        <Setter Property="BorderBrush" Value="#FED7D7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8"
                                                     VerticalAlignment="Top" Margin="0,4,0,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#3B82F6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                                <Setter Property="Fill" Value="#EF4444"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                                <TextBlock FontSize="12" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#0C4A6E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                                    <Setter Property="Foreground" Value="#991B1B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding TimeText}"/> <Run Text=" · "/> <Run Text="{Binding Actor}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                           TextWrapping="Wrap" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#4A7A9B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
    </Grid>
</Page>
